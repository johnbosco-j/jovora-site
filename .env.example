# Clareo's own domain. While unset, the "Visit Clareo" button shows "coming soon".
NEXT_PUBLIC_CLAREO_URL=
# Founder portfolio. While unset, the button reads "Portfolio — coming soon".
NEXT_PUBLIC_PORTFOLIO_URL=
# Public site URL (used for metadata, sitemap and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://jovora.com

# Contact form delivery (optional). Without these, submissions are logged on the server.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Jovora <noreply@jovora.com>
