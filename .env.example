# Where Clareo lives. Default: https://clareo.<site domain>. rivendevs.in/clareo redirects here.
NEXT_PUBLIC_CLAREO_URL=

# Canonical site URL, used for metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://rivendevs.in

# Founder portfolio. While unset, the button reads "Portfolio — coming soon".
NEXT_PUBLIC_PORTFOLIO_URL=

# Contact form (Resend). Without a key, messages are logged on the server only.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Riven <noreply@rivendevs.in>
